[global]

	### Appearance ###
    frame_color = "#a6adc8"
    frame_width = 0
	gap_size=4
    corner_radius = 10
	 
    horizontal_padding = 8
    separator_height = 2
    notification_height = 0
    transparency = 0
	origin = top-right
	offset = 15x15
    icon_position = left
   

    ### Display ###
    follow = mouse
    indicate_hidden = yes
    shrink = no
    sort = yes
    idle_threshold = 0
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = true


    ### Text ### 
    # Message format:
    # %a - appname
    # %s - summary
    # %b - body
    # %i - iconname (with path)
    # %I - iconname (without path)
    # %p - progress value (if set)
    # %n - progress value no extra characters
    # %% - literal %
    format = "<b>%a</b>\n<i>%s</i>\n%b"
    font = Iosevka 10
    padding = 8
    line-height = 0
    markup = full
    alignment = center
    vertical_alignment = center
    show_age_threshold = -1
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no 


    ### Misc ###
    history_length = 20
    dmenu = /usr/bin/fuzzel -d -p "dunst: "
    browser = /usr/bin/floorp -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst
    startup_notification = false
    verbosity = mesg
    ignore_dbusclose = false
	fullscreen = pushback

    ### Mouse ###

    mouse_left_click = do_action
    mouse_middle_click = close_all
    mouse_right_click = close_current

[shortcuts]

    close = ctrl+space
    close_all = ctrl+shift+space

[urgency_normal]

    # Normal urgency notifications
    background = "#313244"
    foreground = "#ffffff"
    timeout = 5

[urgency_critical]

    # High urgency notifications
    background = "#ffffff"
    foreground = "#db0101"
    timeout = 0

[urgency_low]

    # Normal urgency notifications
    background = "#313244"
    foreground = "#ffffff"
    timeout = 2
