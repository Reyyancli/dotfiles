# Swap containers
bindsym $mod+S mark --add "swapee"; mode "swap"; exec notify-send -a "Swap" -u low "Marked $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
mode "swap" {
	bindsym $mod+S swap container with mark "swapee"; unmark "swapee"; mode "default"
	bindsym $mod+space swap container with mark "swapee"; unmark "swapee"; mode "default"
	bindsym Escape mode "default"; exec notify-send -a "Swap" -u low "Exiting Swap Mode" 

	# switch to workspace
	bindsym $mod+1 workspace number $ws1
	bindsym $mod+2 workspace number $ws2
	bindsym $mod+3 workspace number $ws3
	bindsym $mod+4 workspace number $ws4
	bindsym $mod+5 workspace number $ws5
	bindsym $mod+6 workspace number $ws6
	bindsym $mod+7 workspace number $ws7
	bindsym $mod+8 workspace number $ws8
	bindsym $mod+9 workspace number $ws9
	bindsym $mod+Mod1+1 workspace number $ws10
	bindsym $mod+Mod1+2 workspace number $ws11
	bindsym $mod+Mod1+3 workspace number $ws12
	bindsym $mod+Mod1+4 workspace number $ws13
	bindsym $mod+Mod1+5 workspace number $ws14

	# change focus
	bindsym $mod+j focus left
	bindsym $mod+k focus down
	bindsym $mod+l focus up
	bindsym $mod+semicolon focus right

	bindsym $mod+Left focus left
	bindsym $mod+Down focus down
	bindsym $mod+Up focus up
	bindsym $mod+Right focus right
}


bindsym $mod+apostrophe mark --add "mm1"; exec notify-send -a "Multimark" -u low "Marked 1 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"; mode "multimark" 
mode "multimark" {
	bindsym 1 mark --add "mm1"; exec notify-send -a "Multimark" -u low "Marked 1 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 2 mark --add "mm2"; exec notify-send -a "Multimark" -u low "Marked 2 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 3 mark --add "mm3"; exec notify-send -a "Multimark" -u low "Marked 3 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 4 mark --add "mm4"; exec notify-send -a "Multimark" -u low "Marked 4 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 5 mark --add "mm5"; exec notify-send -a "Multimark" -u low "Marked 5 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 6 mark --add "mm6"; exec notify-send -a "Multimark" -u low "Marked 6 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 7 mark --add "mm7"; exec notify-send -a "Multimark" -u low "Marked 7 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 8 mark --add "mm8"; exec notify-send -a "Multimark" -u low "Marked 8 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 9 mark --add "mm9"; exec notify-send -a "Multimark" -u low "Marked 9 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"
	bindsym 0 mark --add "mm0"; exec notify-send -a "Multimark" -u low "Marked 0 $(xprop -id "$(xdotool getwindowfocus)" WM_CLASS | sed -E 's/.*"([^"]+)".*/\1/')"

	bindsym Escape mode "default"; unmark; exec notify-send -a "Swap" -u low "Exiting Swap Mode" 
	bindsym Return [con_mark="mm1"] move workspace current; [con_mark="mm2"] move workspace current; [con_mark="mm3"] move workspace current; [con_mark="mm4"] move workspace current; [con_mark="mm5"] move workspace current; [con_mark="mm6"] move workspace current; [con_mark="mm7"] move workspace current; [con_mark="mm8"] move workspace current; [con_mark="mm9"] move workspace current; [con_mark="mm0"] move workspace current; unmark; mode "default";

	# switch to workspace
	bindsym $mod+1 workspace number $ws1
	bindsym $mod+2 workspace number $ws2
	bindsym $mod+3 workspace number $ws3
	bindsym $mod+4 workspace number $ws4
	bindsym $mod+5 workspace number $ws5
	bindsym $mod+6 workspace number $ws6
	bindsym $mod+7 workspace number $ws7
	bindsym $mod+8 workspace number $ws8
	bindsym $mod+9 workspace number $ws9
	bindsym $mod+Mod1+1 workspace number $ws10
	bindsym $mod+Mod1+2 workspace number $ws11
	bindsym $mod+Mod1+3 workspace number $ws12
	bindsym $mod+Mod1+4 workspace number $ws13
	bindsym $mod+Mod1+5 workspace number $ws14
	
	bindsym $mod+space focus mode_toggle

	# change focus
	bindsym $mod+j focus left
	bindsym $mod+k focus down
	bindsym $mod+l focus up
	bindsym $mod+semicolon focus right

	bindsym $mod+Left focus left
	bindsym $mod+Down focus down
	bindsym $mod+Up focus up
	bindsym $mod+Right focus right
}

